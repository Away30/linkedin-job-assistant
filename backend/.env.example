# LinkedIn Job Assistant Backend Configuration
# All settings use LJA_ prefix per pydantic-settings

# Server
LJA_HOST=127.0.0.1
LJA_PORT=8899

# Chrome extension
# Set this after loading the unpacked extension in chrome://extensions.
# Example: LJA_EXTENSION_ID=abcdefghijklmnopqrstuvwxyzabcdef
LJA_EXTENSION_ID=

# Database
LJA_DATABASE_URL=sqlite:///./data/db/linkedin_assistant.db

# Browser
LJA_BROWSER_PROFILE_DIR=./data/browser_profile

# Rate Limits
LJA_MAX_APPLIES_PER_DAY=25
LJA_MAX_CONNECTS_PER_DAY=20

# Delays (seconds)
LJA_ACTION_DELAY_MIN=3.0
LJA_ACTION_DELAY_MAX=12.0

# Warmup
LJA_WARMUP_DAYS=7
LJA_WARMUP_START_APPLIES=3

# Session limits
LJA_MAX_SESSION_MINUTES=120
LJA_BREAK_INTERVAL_MINUTES_MIN=40
LJA_BREAK_INTERVAL_MINUTES_MAX=60
LJA_BREAK_DURATION_MINUTES_MIN=5
LJA_BREAK_DURATION_MINUTES_MAX=15

# Paths
LJA_FORM_ANSWERS_PATH=./data/config/form_answers.yaml
LJA_RESUME_DIR=./data/resumes

# CORS
LJA_CORS_ORIGINS=["chrome-extension://*", "http://localhost:*"]
