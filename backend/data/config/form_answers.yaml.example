# Pre-configured form answers for LinkedIn Easy Apply
# Keys are matched against form field labels using fuzzy matching.
# Copy this file to form_answers.yaml and fill in your real values.
# DO NOT commit form_answers.yaml — it is gitignored to protect PII.

# Contact info
phone_number: "555-0100"
